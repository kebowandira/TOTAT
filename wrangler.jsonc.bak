// RETIRED 2026-09-17 — superseded by 13 separate Cloudflare Pages Classic
// projects (see CLAUDE.md). Kept only in case a future dynamic API
// Worker is built; not used for landing-page routing anymore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "totat",
  "compatibility_date": "2026-09-17",
  "main": "./worker.js",
  "assets": {
    "directory": "./sites",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
